#!/usr/bin/env bash
#
# healthcheck - Health check for the bilicache player plugin
#
# Usage:
#   ./healthcheck
#
# Assumes layout:
#   <script_dir>/bin/<plugin>          (any single executable/python file)
#   <script_dir>/config/config.json
#
# Exit codes:
#   0 = all checks passed
#   1 = one or more checks failed
#

set -u

# ---------- locate ourselves ----------
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    dir="$(cd -P "$(dirname -- "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    case "$SELF" in
        /*) ;;
        *) SELF="$dir/$SELF" ;;
    esac
done
SELF_DIR="$(cd -P "$(dirname -- "$SELF")" && pwd)"

BIN_DIR="$SELF_DIR/bin"
CONFIG_FILE="$SELF_DIR/config/config.json"

# ---------- colors ----------
if [ -t 1 ]; then
    RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; NC=$'\033[0m'
else
    RED=""; GREEN=""; YELLOW=""; NC=""
fi

PASS=0
FAIL=0

ok()   { printf '%s[ OK ]%s %s\n'   "$GREEN"  "$NC" "$1"; PASS=$((PASS+1)); }
bad()  { printf '%s[FAIL]%s %s\n'   "$RED"    "$NC" "$1"; FAIL=$((FAIL+1)); }
warn() { printf '%s[WARN]%s %s\n'   "$YELLOW" "$NC" "$1"; }
info() { printf '[INFO] %s\n' "$1"; }

info "base dir: $SELF_DIR"

# ---------- 1. find the plugin in bin/ ----------
if [ ! -d "$BIN_DIR" ]; then
    bad "bin/ directory missing: $BIN_DIR"
    exit 1
fi

# Collect regular files in bin/, excluding obvious non-plugins
PLUGIN_CANDIDATES=()
while IFS= read -r -d '' f; do
    base="$(basename -- "$f")"
    case "$base" in
        .*|*.bak|*.log|*.tmp|*.swp|*~) continue ;;
    esac
    PLUGIN_CANDIDATES+=("$f")
done < <(find "$BIN_DIR" -maxdepth 1 -type f -print0 2>/dev/null)

if [ "${#PLUGIN_CANDIDATES[@]}" -eq 0 ]; then
    bad "no plugin file found in $BIN_DIR"
    exit 1
fi

if [ "${#PLUGIN_CANDIDATES[@]}" -gt 1 ]; then
    warn "multiple files in bin/, picking the first one:"
    for f in "${PLUGIN_CANDIDATES[@]}"; do info "  - $f"; done
fi

SCRIPT_PATH="${PLUGIN_CANDIDATES[0]}"
info "plugin:   $SCRIPT_PATH"
info "config:   $CONFIG_FILE"

# ---------- 2. runner ----------
# Prefer direct exec if executable; else if it looks like python, run via python3.
if [ -x "$SCRIPT_PATH" ]; then
    RUNNER=("$SCRIPT_PATH")
else
    if head -c 64 "$SCRIPT_PATH" 2>/dev/null | grep -q '^#!.*python'; then
        warn "plugin not executable, running via python3"
        RUNNER=(python3 "$SCRIPT_PATH")
    else
        warn "plugin not executable; trying to run directly anyway"
        RUNNER=("$SCRIPT_PATH")
    fi
fi

# ---------- 3. --support ----------
if out=$("${RUNNER[@]}" --support 2>/dev/null); then
    if [ "$out" = "bilicache" ]; then
        ok "--support reports 'bilicache'"
    else
        bad "--support returned unexpected output: '$out'"
    fi
else
    bad "--support failed to run"
fi

# ---------- 4. config.json ----------
if [ ! -f "$CONFIG_FILE" ]; then
    bad "config.json missing: $CONFIG_FILE"
    ROOT=""
else
    ROOT=$(python3 - "$CONFIG_FILE" <<'PY' 2>/dev/null
import json, sys
try:
    with open(sys.argv[1]) as f:
        print(json.load(f).get("root", ""))
except Exception:
    print("")
PY
)
    if [ -z "$ROOT" ]; then
        bad "config.json 'root' is empty"
    elif [ ! -d "$ROOT" ]; then
        bad "config.json root not a directory: $ROOT"
    else
        ok "root directory: $ROOT"
    fi
fi

# ---------- 5. external tools ----------
if command -v ffplay >/dev/null 2>&1; then
    if ffplay -version >/dev/null 2>&1; then
        ok "ffplay available"
    else
        bad "ffplay present but not runnable"
    fi
else
    bad "ffplay not found in PATH"
fi

command -v tail    >/dev/null 2>&1 && ok "tail available"    || bad "tail not found in PATH"
command -v python3 >/dev/null 2>&1 && ok "python3 available" || bad "python3 not found in PATH"

# ---------- 6. optional: sample JSON ----------
if [ -n "${SAMPLE_CID:-}" ]; then
    sample=$(printf '{"cid":"%s","title":"Test Title","group":"Test Group","category":"Test Category"}' "$SAMPLE_CID")

    info "Testing --canwork with cid=$SAMPLE_CID"
    "${RUNNER[@]}" --canwork "$sample" >/dev/null 2>&1 \
        && ok "--canwork succeeded for cid=$SAMPLE_CID" \
        || bad "--canwork failed for cid=$SAMPLE_CID"

    info "Testing --title with cid=$SAMPLE_CID"
    if title=$("${RUNNER[@]}" --title "$sample" 2>/dev/null); then
        [ -n "$title" ] && ok "--title returned: $title" || bad "--title returned empty"
    else
        bad "--title failed"
    fi

    info "Testing --cover with cid=$SAMPLE_CID"
    if cover=$("${RUNNER[@]}" --cover "$sample" 2>/dev/null); then
        if   [ -z "$cover" ]; then
            warn "--cover returned empty (no cover)"
        elif [ -f "$cover" ]; then
            ok "--cover returned existing file: $cover"
        else
            warn "--cover returned non-existent path: $cover"
        fi
    else
        bad "--cover failed"
    fi
else
    warn "SAMPLE_CID not set; skipping --canwork/--cover/--title tests"
fi

# ---------- summary ----------
echo
printf 'Summary: %s%d passed%s, %s%d failed%s\n' \
    "$GREEN" "$PASS" "$NC" \
    "$RED"   "$FAIL" "$NC"

[ "$FAIL" -eq 0 ]
