#!/usr/bin/env bash
#
# healthcheck - Health check for the steam player plugin
#
# Usage:
#   ./healthcheck
#   SAMPLE_FILE=/path/to/song.flac ./healthcheck   # optional integration test
#
# Assumes layout:
#   <script_dir>/bin/<plugin>          (any single regular file)
#
# Exit codes:
#   0 = all checks passed
#   1 = one or more checks failed
#

set -u

# ---------- locate ourselves ----------
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    dir="$(cd -P "$(dirname -- "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    case "$SELF" in
        /*) ;;
        *) SELF="$dir/$SELF" ;;
    esac
done
SELF_DIR="$(cd -P "$(dirname -- "$SELF")" && pwd)"

BIN_DIR="$SELF_DIR/bin"
TMP_DIR="/tmp/steam_covers"

# ---------- colors ----------
if [ -t 1 ]; then
    RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; NC=$'\033[0m'
else
    RED=""; GREEN=""; YELLOW=""; NC=""
fi

PASS=0
FAIL=0

ok()   { printf '%s[ OK ]%s %s\n'   "$GREEN"  "$NC" "$1"; PASS=$((PASS+1)); }
bad()  { printf '%s[FAIL]%s %s\n'   "$RED"    "$NC" "$1"; FAIL=$((FAIL+1)); }
warn() { printf '%s[WARN]%s %s\n'   "$YELLOW" "$NC" "$1"; }
info() { printf '[INFO] %s\n' "$1"; }

info "base dir: $SELF_DIR"

# ---------- 1. find the plugin in bin/ ----------
if [ ! -d "$BIN_DIR" ]; then
    bad "bin/ directory missing: $BIN_DIR"
    exit 1
fi

PLUGIN_CANDIDATES=()
while IFS= read -r -d '' f; do
    base="$(basename -- "$f")"
    case "$base" in
        .*|*.bak|*.log|*.tmp|*.swp|*~) continue ;;
    esac
    PLUGIN_CANDIDATES+=("$f")
done < <(find "$BIN_DIR" -maxdepth 1 -type f -print0 2>/dev/null)

if [ "${#PLUGIN_CANDIDATES[@]}" -eq 0 ]; then
    bad "no plugin file found in $BIN_DIR"
    exit 1
fi

if [ "${#PLUGIN_CANDIDATES[@]}" -gt 1 ]; then
    warn "multiple files in bin/, picking the first one:"
    for f in "${PLUGIN_CANDIDATES[@]}"; do info "  - $f"; done
fi

SCRIPT_PATH="${PLUGIN_CANDIDATES[0]}"
info "plugin:   $SCRIPT_PATH"

# ---------- 2. runner ----------
if [ -x "$SCRIPT_PATH" ]; then
    RUNNER=("$SCRIPT_PATH")
else
    if head -c 64 "$SCRIPT_PATH" 2>/dev/null | grep -q '^#!.*python'; then
        warn "plugin not executable, running via python3"
        RUNNER=(python3 "$SCRIPT_PATH")
    else
        warn "plugin not executable; trying to run directly anyway"
        RUNNER=("$SCRIPT_PATH")
    fi
fi

# ---------- 3. --support ----------
if out=$("${RUNNER[@]}" --support 2>/dev/null); then
    if [ "$out" = "steam" ]; then
        ok "--support reports 'steam'"
    else
        bad "--support returned unexpected output: '$out'"
    fi
else
    bad "--support failed to run"
fi

# ---------- 4. external tools ----------
if command -v ffmpeg >/dev/null 2>&1; then
    if ffmpeg -version >/dev/null 2>&1; then
        ver=$(ffmpeg -version 2>/dev/null | head -n1 | awk '{print $3}')
        ok "ffmpeg available ($ver)"
    else
        bad "ffmpeg present but not runnable"
    fi
else
    bad "ffmpeg not found in PATH"
fi

command -v python3 >/dev/null 2>&1 && ok "python3 available" || bad "python3 not found in PATH"

# ---------- 5. cover cache dir ----------
if [ -d "$TMP_DIR" ]; then
    if [ -w "$TMP_DIR" ]; then
        ok "cover cache dir writable: $TMP_DIR"
    else
        bad "cover cache dir not writable: $TMP_DIR"
    fi
else
    parent="$(dirname -- "$TMP_DIR")"
    if [ -w "$parent" ]; then
        ok "cover cache dir will be created under $parent"
    else
        warn "cover cache dir missing and $parent not writable"
    fi
fi

# ---------- 6. optional: integration test ----------
if [ -n "${SAMPLE_FILE:-}" ]; then
    if [ ! -f "$SAMPLE_FILE" ]; then
        bad "SAMPLE_FILE does not exist: $SAMPLE_FILE"
    else
        sample=$(python3 - "$SAMPLE_FILE" <<'PY'
import json, sys
print(json.dumps({
    "bvid": sys.argv[1],
    "title": "Test Title",
    "group": "Test Group",
    "category": "Test Category",
}))
PY
)

        info "Testing --canwork with file=$SAMPLE_FILE"
        "${RUNNER[@]}" --canwork "$sample" >/dev/null 2>&1 \
            && ok "--canwork succeeded" \
            || bad "--canwork failed"

        info "Testing --title"
        if title=$("${RUNNER[@]}" --title "$sample" 2>/dev/null); then
            [ -n "$title" ] && ok "--title returned: $title" || bad "--title returned empty"
        else
            bad "--title failed"
        fi

        info "Testing --cover"
        if cover=$("${RUNNER[@]}" --cover "$sample" 2>/dev/null); then
            if   [ -z "$cover" ]; then
                warn "--cover returned empty (no embedded cover)"
            elif [ -f "$cover" ]; then
                ok "--cover returned existing file: $cover"
            else
                warn "--cover returned non-existent path: $cover"
            fi
        else
            bad "--cover failed"
        fi

        info "Testing --getrawdata (first 64 KiB)"
        n=$( "${RUNNER[@]}" --getrawdata "$sample" 2>/dev/null | head -c 65536 | wc -c )
        if [ "$n" -gt 0 ]; then
            ok "--getrawdata produced $n bytes (truncated)"
        else
            bad "--getrawdata produced no output"
        fi
    fi
else
    warn "SAMPLE_FILE not set; skipping --canwork/--cover/--title/--getrawdata tests"
fi

# ---------- summary ----------
echo
printf 'Summary: %s%d passed%s, %s%d failed%s\n' \
    "$GREEN" "$PASS" "$NC" \
    "$RED"   "$FAIL" "$NC"

[ "$FAIL" -eq 0 ]
