#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/local/tcp_stream_player"
TS_DIR="${TS_DIR:-/tmp/ts_stream}"
FIFO="/tmp/tcp_stream_player.fifo"
SOURCE_LIST="$SCRIPT_DIR/source_list.txt"
POLL_INTERVAL="${POLL_INTERVAL:-0.5}"

# ============================================
# 读数据源配置
# ============================================
if [ ! -f "$SOURCE_LIST" ]; then
    echo "❌ 找不到 source_list.txt: $SOURCE_LIST" >&2
    exit 1
fi

SOURCE=$(grep -v '^\s*#' "$SOURCE_LIST" | grep -v '^\s*$' | head -n 1)
SOURCE=$(echo "$SOURCE" | tr -d '\r')

if [ -z "$SOURCE" ]; then
    echo "❌ source_list.txt 为空" >&2
    exit 1
fi

echo "📡 数据源: $SOURCE"

# ============================================
# 初始化：清空临时目录
# ============================================
echo "🧹 清空临时目录: $TS_DIR"
rm -rf "$TS_DIR"
mkdir -p "$TS_DIR"

# ============================================
# 本地模式
# ============================================
if [ "$SOURCE" = "local" ]; then
    echo "🏠 本地模式"
    echo "   TS 目录: $TS_DIR"
    echo "   URL:     http://localhost:10723"
    echo ""

    # 创建 FIFO
    rm -f "$FIFO"
    mkfifo "$FIFO"

    # 保持写端（防止 Go 服务 open 阻塞）
    (
        exec 3>"$FIFO"
        while true; do sleep 3600; done
    ) &
    HOLDER_PID=$!

    # ★★★ 轮询监控：读一个删一个 ★★★
    (
        declare -A SEEN

        echo "⏳ 等待第一个分片..." >&2
        # 等第一个分片
        while [ -z "$(ls -A "$TS_DIR"/*.ts 2>/dev/null)" ]; do
            sleep "$POLL_INTERVAL"
        done
        echo "✅ 检测到分片，开始监控" >&2

        while true; do
            for f in "$TS_DIR"/*.ts; do
                [ -f "$f" ] || continue
                # 跳过已处理
                [[ -n "${SEEN[$f]}" ]] && continue

                # 检查文件是否还在写（大小稳定才算写完）
                SIZE1=$(stat -c%s "$f" 2>/dev/null || echo 0)
                sleep 0.1
                SIZE2=$(stat -c%s "$f" 2>/dev/null || echo 0)
                [ "$SIZE1" != "$SIZE2" ] && continue
                [ "$SIZE1" = "0" ] && continue

                SEEN["$f"]=1
                echo "📤 分片: $(basename "$f") ($SIZE1 bytes)" >&2

                cat "$f" > "$FIFO" 2>/dev/null || true
                rm -f "$f"
            done
            sleep "$POLL_INTERVAL"
        done
    ) &
    TS_FEEDER_PID=$!

    cleanup() {
        kill "$HOLDER_PID" "$TS_FEEDER_PID" 2>/dev/null || true
        rm -f "$FIFO"
    }
    trap cleanup EXIT

    echo "🚀 启动 Go 服务..."
    echo ""

    # Go 服务从 FIFO 读
    exec "$BIN" -listen :10723 -type video/mp2t < "$FIFO"
fi

# ============================================
# 远程模式
# ============================================
if [[ "$SOURCE" == http://* ]] || [[ "$SOURCE" == https://* ]]; then
    echo "🌐 远程模式"
    echo "   目标: $SOURCE"
    echo "   TS 目录: $TS_DIR"
    echo ""

    URL="${SOURCE%/}/segment"
    echo "   推送: $URL"

    # ★★★ 轮询监控：上传一个删一个 ★★★
    declare -A SEEN

    echo "⏳ 等待第一个分片..."
    while [ -z "$(ls -A "$TS_DIR"/*.ts 2>/dev/null)" ]; do
        sleep "$POLL_INTERVAL"
    done
    echo "✅ 检测到分片，开始上传"
    echo ""

    while true; do
        for f in "$TS_DIR"/*.ts; do
            [ -f "$f" ] || continue
            [[ -n "${SEEN[$f]}" ]] && continue

            # 检查文件是否还在写
            SIZE1=$(stat -c%s "$f" 2>/dev/null || echo 0)
            sleep 0.1
            SIZE2=$(stat -c%s "$f" 2>/dev/null || echo 0)
            [ "$SIZE1" != "$SIZE2" ] && continue
            [ "$SIZE1" = "0" ] && continue

            SEEN["$f"]=1
            echo "📤 上传: $(basename "$f") ($SIZE1 bytes)" >&2

            if curl --http1.1 -s -X POST \
                -H "Content-Type: video/mp2t" \
                --data-binary "@$f" \
                "$URL" \
                -o /dev/null -w "  → HTTP %{http_code} (%{size_upload} bytes)\n" >&2; then
                rm -f "$f"
            fi
        done
        sleep "$POLL_INTERVAL"
    done

    exit 0
fi

# ============================================
# 未知格式
# ============================================
echo "❌ 未知数据源格式: $SOURCE" >&2
echo "   支持: local | http://... | https://..." >&2
exit 1
