#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/local/tcp_stream_player"
TS_DIR="${TS_DIR:-/tmp/ts_stream}"
FIFO="/tmp/tcp_stream_player.fifo"
SOURCE_LIST="$SCRIPT_DIR/source_list.txt"

# ============================================
# 读数据源配置
# ============================================
if [ ! -f "$SOURCE_LIST" ]; then
    echo "❌ 找不到 source_list.txt: $SOURCE_LIST" >&2
    exit 1
fi

SOURCE=$(grep -v '^\s*#' "$SOURCE_LIST" | grep -v '^\s*$' | head -n 1)
SOURCE=$(echo "$SOURCE" | tr -d '\r')

if [ -z "$SOURCE" ]; then
    echo "❌ source_list.txt 为空" >&2
    exit 1
fi

echo "📡 数据源: $SOURCE"

# ============================================
# 本地模式：监控 TS 目录，喂给 Go 服务
# ============================================
if [ "$SOURCE" = "local" ]; then
    echo "🏠 本地模式"
    echo "   TS 目录: $TS_DIR"
    echo "   URL:     http://localhost:10723"

    mkdir -p "$TS_DIR"

    # 创建 FIFO，Go 服务从这里读
    rm -f "$FIFO"
    mkfifo "$FIFO"

    # ★★★ 监控 TS 目录，新分片就写入 FIFO ★★★
    (
        # 记录已处理的文件
        declare -A SEEN

        # 先处理已存在的文件
        for f in "$TS_DIR"/*.ts; do
            [ -f "$f" ] || continue
            echo "📤 初始分片: $f" >&2
            cat "$f" > "$FIFO"
            SEEN["$f"]=1
        done

        # 监控新文件
        inotifywait -m -e close_write --format '%w%f' "$TS_DIR" 2>/dev/null | \
        while read -r file; do
            [[ "$file" != *.ts ]] && continue
            [[ -n "${SEEN[$file]}" ]] && continue
            SEEN["$file"]=1

            echo "📤 新分片: $file" >&2
            cat "$file" > "$FIFO"
        done
    ) &
    TS_FEEDER_PID=$!

    cleanup() {
        kill "$TS_FEEDER_PID" 2>/dev/null || true
        rm -f "$FIFO"
    }
    trap cleanup EXIT

    echo ""
    echo "🚀 启动 Go 服务..."

    # Go 服务从 FIFO 读
    exec "$BIN" -listen :10723 -type video/mp2t < "$FIFO"
fi

# ============================================
# 远程模式：监控 TS 目录，逐个上传
# ============================================
if [[ "$SOURCE" == http://* ]] || [[ "$SOURCE" == https://* ]]; then
    echo "🌐 远程模式"
    echo "   目标: $SOURCE"
    echo "   TS 目录: $TS_DIR"

    mkdir -p "$TS_DIR"

    URL="${SOURCE%/}/segment"

    echo "   推送: $URL"
    echo ""

    # ★★★ 监控 TS 目录，逐个上传 ★★★
    inotifywait -m -e close_write --format '%w%f' "$TS_DIR" 2>/dev/null | \
    while read -r file; do
        [[ "$file" != *.ts ]] && continue

        echo "📤 上传: $(basename "$file")" >&2

        # 单个分片单独 POST
        curl --http1.1 -s -X POST \
            -H "Content-Type: video/mp2t" \
            --data-binary "@$file" \
            "$URL" \
            -o /dev/null -w "  → HTTP %{http_code} (%{size_upload} bytes)\n" >&2

        # 可选：上传后删除
        # rm -f "$file"
    done

    exit 0
fi

# ============================================
# 未知格式
# ============================================
echo "❌ 未知数据源格式: $SOURCE" >&2
exit 1
