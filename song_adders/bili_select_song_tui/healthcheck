#!/usr/bin/env bash
#
# healthcheck - Health check for bili_select_song_tui
#
# Checks:
#   1. go.mod / go.sum present
#   2. cmd/tui/main.go present
#   3. cmd/tui/tui binary exists (or prints build instructions)
#   4. easy_edit.sh present & executable
#   5. sibling symlinks (build, tree.json) resolve
#
# Exit codes:
#   0 = all checks passed
#   1 = one or more checks failed
#

set -u

# ---------- locate ourselves ----------
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    dir="$(cd -P "$(dirname -- "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    case "$SELF" in
        /*) ;;
        *) SELF="$dir/$SELF" ;;
    esac
done
SELF_DIR="$(cd -P "$(dirname -- "$SELF")" && pwd)"

GO_MOD="$SELF_DIR/go.mod"
GO_SUM="$SELF_DIR/go.sum"
TUI_SRC="$SELF_DIR/cmd/tui/main.go"
TUI_BIN="$SELF_DIR/cmd/tui/tui"
EASY_EDIT="$SELF_DIR/easy_edit.sh"
BUILD_LINK="$SELF_DIR/cmd/tui/build"
TREE_LINK="$SELF_DIR/cmd/tui/tree.json"

# ---------- colors ----------
if [ -t 1 ]; then
    RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; NC=$'\033[0m'
else
    RED=""; GREEN=""; YELLOW=""; NC=""
fi

PASS=0; FAIL=0

ok()   { printf '%s[ OK ]%s %s\n'   "$GREEN"  "$NC" "$1"; PASS=$((PASS+1)); }
bad()  { printf '%s[FAIL]%s %s\n'   "$RED"    "$NC" "$1"; FAIL=$((FAIL+1)); }
warn() { printf '%s[WARN]%s %s\n'   "$YELLOW" "$NC" "$1"; }
info() { printf '[INFO] %s\n' "$1"; }

info "base dir: $SELF_DIR"

# ---------- 1. Go project files ----------
[ -f "$GO_MOD" ] && ok "go.mod present" || bad "go.mod missing"
[ -f "$GO_SUM" ] && ok "go.sum present" || warn "go.sum missing"
[ -f "$TUI_SRC" ] && ok "cmd/tui/main.go present" || bad "cmd/tui/main.go missing"

# ---------- 2. sibling symlinks ----------
for link in "$BUILD_LINK" "$TREE_LINK"; do
    name="cmd/tui/$(basename "$link")"
    if [ -L "$link" ]; then
        if [ -e "$link" ]; then
            ok "$name → $(readlink "$link")"
        else
            warn "$name is a broken symlink → $(readlink "$link")"
        fi
    elif [ -e "$link" ]; then
        info "$name is a real file (not a symlink)"
    else
        info "$name not present (optional)"
    fi
done

# ---------- 3. TUI binary ----------
if [ -x "$TUI_BIN" ]; then
    size=$(stat -c%s "$TUI_BIN" 2>/dev/null || echo 0)
    ok "cmd/tui/tui present ($size bytes)"
elif [ -f "$TUI_BIN" ]; then
    bad "cmd/tui/tui exists but is not executable: $TUI_BIN"
else
    bad "cmd/tui/tui not built: $TUI_BIN"
    echo ""
    echo "  Please build it yourself:"
    echo "      cd $SELF_DIR"
    echo "      go build -o cmd/tui/tui ./cmd/tui"
    echo ""
    exit 1
fi

# ---------- 4. easy_edit.sh ----------
if [ -f "$EASY_EDIT" ]; then
    ok "easy_edit.sh present"
    [ -x "$EASY_EDIT" ] && ok "easy_edit.sh executable" || bad "easy_edit.sh not executable"
else
    warn "easy_edit.sh missing: $EASY_EDIT"
fi

# ---------- 5. tools ----------
for tool in bash jq go; do
    command -v "$tool" >/dev/null 2>&1 && ok "$tool available" || warn "$tool not in PATH"
done

# ---------- summary ----------
echo
printf 'Summary: %s%d passed%s, %s%d failed%s\n' \
    "$GREEN" "$PASS" "$NC" \
    "$RED"   "$FAIL" "$NC"

[ "$FAIL" -eq 0 ]
