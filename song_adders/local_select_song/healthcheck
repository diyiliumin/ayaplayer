#!/usr/bin/env bash
#
# healthcheck - Health check for local_select_song
#
# Checks:
#   1. run entry point
#   2. buildtree_local/build_local.sh & buildtree_local.py
#   3. python3 syntax + stdlib-only
#   4. path.txt -s mode returns the file
#   5. path.txt resolves to a real directory
#   6. tree.json valid JSON (if present)
#   7. sibling bili_select_song_tui symlink + binary
#
# Exit codes:
#   0 = all checks passed
#   1 = one or more checks failed
#

set -u

# ---------- locate ourselves ----------
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    dir="$(cd -P "$(dirname -- "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    case "$SELF" in
        /*) ;;
        *) SELF="$dir/$SELF" ;;
    esac
done
SELF_DIR="$(cd -P "$(dirname -- "$SELF")" && pwd)"

RUN="$SELF_DIR/run"
LOCAL_DIR="$SELF_DIR/buildtree_local"
BUILD_SH="$LOCAL_DIR/build_local.sh"
BUILD_PY="$LOCAL_DIR/buildtree_local.py"
PATH_TXT="$LOCAL_DIR/path.txt"
TREE_JSON="$LOCAL_DIR/tree.json"
TUI_LINK="$SELF_DIR/bili_select_song_tui"

# ---------- colors ----------
if [ -t 1 ]; then
    RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; NC=$'\033[0m'
else
    RED=""; GREEN=""; YELLOW=""; NC=""
fi

PASS=0; FAIL=0

ok()   { printf '%s[ OK ]%s %s\n'   "$GREEN"  "$NC" "$1"; PASS=$((PASS+1)); }
bad()  { printf '%s[FAIL]%s %s\n'   "$RED"    "$NC" "$1"; FAIL=$((FAIL+1)); }
warn() { printf '%s[WARN]%s %s\n'   "$YELLOW" "$NC" "$1"; }
info() { printf '[INFO] %s\n' "$1"; }

info "base dir: $SELF_DIR"

# ---------- 1. run entry point ----------
if [ -f "$RUN" ]; then
    ok "run present"
    [ -x "$RUN" ] && ok "run executable" || bad "run not executable"
else
    bad "run missing: $RUN"
fi

# ---------- 2. buildtree_local files ----------
if [ -f "$BUILD_SH" ]; then
    ok "build_local.sh present"
    [ -x "$BUILD_SH" ] && ok "build_local.sh executable" || bad "build_local.sh not executable"
else
    bad "build_local.sh missing: $BUILD_SH"
fi

if [ -f "$BUILD_PY" ]; then
    ok "buildtree_local.py present"
else
    bad "buildtree_local.py missing: $BUILD_PY"
fi

# ---------- 3. python syntax + stdlib-only ----------
if command -v python3 >/dev/null 2>&1; then
    if [ -f "$BUILD_PY" ]; then
        if python3 -m py_compile "$BUILD_PY" 2>/dev/null; then
            ok "buildtree_local.py compiles"
        else
            bad "buildtree_local.py has a syntax error"
        fi

        # Ensure it only uses stdlib (hashlib, json, pathlib, sys)
        third_party=$(grep -E '^\s*(import|from)\s+' "$BUILD_PY" \
            | grep -vE '\b(hashlib|json|sys|pathlib|os|re|typing|collections|dataclasses|datetime|functools|itertools|math|random|shutil|subprocess|tempfile|time|uuid)\b' \
            || true)
        if [ -z "$third_party" ]; then
            ok "buildtree_local.py is stdlib-only"
        else
            warn "buildtree_local.py imports non-stdlib modules:"
            echo "$third_party" | sed 's/^/         /'
        fi
    fi
else
    bad "python3 not in PATH"
fi

# ---------- 4. build_local.sh -s ----------
if [ -x "$BUILD_SH" ]; then
    if out=$("$BUILD_SH" -s 2>/dev/null); then
        if [ "$out" = "$PATH_TXT" ] || [ -f "$out" ]; then
            ok "build_local.sh -s → $out"
        else
            warn "build_local.sh -s returned unexpected: $out"
        fi
    else
        bad "build_local.sh -s failed"
    fi
fi

# ---------- 5. path.txt resolution ----------
if [ ! -f "$PATH_TXT" ]; then
    bad "path.txt missing: $PATH_TXT"
else
    # first non-comment, non-blank line
    music_root=$(grep -v '^\s*#' "$PATH_TXT" 2>/dev/null | grep -v '^\s*$' | head -n 1 | tr -d '\r')
    if [ -z "$music_root" ]; then
        bad "path.txt has no usable path (only comments/blank lines)"
    else
        # expand ~ if present
        case "$music_root" in
            "~"*) music_root="${HOME}${music_root#\~}" ;;
        esac
        if [ -d "$music_root" ]; then
            n=$(find "$music_root" -type f \( -iname '*.mp3' -o -iname '*.flac' -o -iname '*.m4a' \
                    -o -iname '*.wav' -o -iname '*.ogg' -o -iname '*.opus' \
                    -o -iname '*.aac'  -o -iname '*.wma' -o -iname '*.m4b' -o -iname '*.mp4' \) \
                    2>/dev/null | wc -l | tr -d ' ')
            ok "music root: $music_root ($n audio file(s))"
        else
            bad "music root is not a directory: $music_root"
        fi
    fi
fi

# ---------- 6. tree.json ----------
if [ -f "$TREE_JSON" ]; then
    if command -v jq >/dev/null 2>&1; then
        if jq -e 'type == "array"' "$TREE_JSON" >/dev/null 2>&1; then
            groups=$(jq 'length' "$TREE_JSON" 2>/dev/null)
            songs=$(jq '[.[].titles[].tabs[].items[]] | length' "$TREE_JSON" 2>/dev/null)
            ok "tree.json valid ($groups group(s), $songs song(s))"
        else
            bad "tree.json is not a JSON array"
        fi
    else
        info "jq not available, skipping tree.json validation"
    fi
else
    info "tree.json not yet generated (run build_local.sh)"
fi

# ---------- 7. TUI sibling ----------
if [ -L "$TUI_LINK" ]; then
    if [ -e "$TUI_LINK" ]; then
        ok "bili_select_song_tui → $(readlink "$TUI_LINK")"
    else
        bad "bili_select_song_tui is a broken symlink → $(readlink "$TUI_LINK")"
    fi
elif [ -d "$TUI_LINK" ]; then
    warn "bili_select_song_tui is a real directory, not a symlink"
else
    warn "bili_select_song_tui missing (optional sibling)"
fi

# TUI binary via the symlink
TUI_BIN="$TUI_LINK/cmd/tui/tui"
if [ -x "$TUI_BIN" ]; then
    size=$(stat -c%s "$TUI_BIN" 2>/dev/null || echo 0)
    ok "TUI binary present via symlink ($size bytes)"
else
    bad "TUI binary not built: $TUI_BIN"
    echo ""
    echo "  Please build it yourself:"
    echo "      cd $SELF_DIR/bili_select_song_tui"
    echo "      go build -o cmd/tui/tui ./cmd/tui"
    echo ""
    exit 1
fi

# ---------- summary ----------
echo
printf 'Summary: %s%d passed%s, %s%d failed%s\n' \
    "$GREEN" "$PASS" "$NC" \
    "$RED"   "$FAIL" "$NC"

[ "$FAIL" -eq 0 ]
