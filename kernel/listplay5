# ============================================
# 播放器调度器 - 基于插件 API
# ============================================

# 获取脚本所在目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ===== 配置 =====
PLAYLIST_FILE="${SCRIPT_DIR}/../to_be_played/playlist.json"
DATA_SOURCE_DIR="${SCRIPT_DIR}/../data_sources/*/bin/"
PLAYER_DIR="${SCRIPT_DIR}/../players/default"
CONTROL_PIPE="/tmp/player_control.pipe"

# ===== 颜色定义 =====
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

# ===== 创建控制管道 =====
rm -f "$CONTROL_PIPE"
mkfifo "$CONTROL_PIPE"

# ============================================
# 插件调度函数
# ============================================
# 在 listplay3 里，播放器启动成功后
publish_dbus() {
    local pid="$1"
    local title="$2"
    local cover="$3"
    local songleft="${4:-0}"
    local paused="${5:-false}"
    
    dbus-send --session \
        --type=signal \
        /com/ayaplayer/Status \
        com.ayaplayer.Interface.StatusChanged \
        "int32:$pid" \
        "string:$title" \
        "string:$cover" \
        "int32:$songleft" \
	"boolean:$paused" \
        2>/dev/null || true
}

# ============================================
# DBus 监听 UI 启动信号
# ============================================
listen_ui_started() {
    dbus-monitor --session "type='signal',interface='com.ayaplayer.Interface',member='UIStarted'" | while read -r line; do
        # 解析 PID
        UI_PID=$(echo "$line" | grep -oE 'int32\s+[0-9]+' | awk '{print $2}')
	# echo "llllllll" >&2
	echo "$UI_PID" "$PLAY_PID" "$TITLE" 
	# echo "llllllll" >&2
        if [ -n "$UI_PID" ] && [ -n "$PLAY_PID" ] && [ -n "$TITLE" ]; then
            echo "🖥️ UI 启动: PID $UI_PID，广播当前状态" >&2
            publish_dbus "$PLAY_PID" "$TITLE" "$COVER_PATH" "$REPEAT_COUNT" "$PAUSED"
        fi
    done
}

# ============================================
# DBus 发送 UI 启动信号
# ============================================
send_ui_started() {
    dbus-send --session \
        --type=signal \
        /com/ayaplayer/Control \
        com.ayaplayer.Interface.Control \
        "string:ui_started" \
        "string:$$" \
        2>/dev/null || true
}

