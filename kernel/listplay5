# 查找并启动播放器
find_and_play() {
    local json="$1"
    local scheme=$(echo "$json" | jq -r '.scheme')
    
    echo -e "\n${CYAN}📡 Scheme: $scheme${NC}\n" >&2
    
    # 遍历所有播放器
    for provider in $DATA_SOURCE_DIR/*; do
        if [ ! -x "$provider" ]; then
            continue
        fi
        
        # 检查是否支持该 scheme
        if "$provider" --support 2>/dev/null | grep -q "$scheme"; then
            echo -e "\n${BLUE}🔍 尝试播放器: $(basename "$provider")${NC}\n" >&2
            
            # 尝试播放
	    # PLAY_PID=$("$" --pproviderlay "$json" )
            # PLAY_PID=$("$" --pproviderlay "$json" 2>/dev/null)

	    player_bin=$(echo "$PLAYER_DIR"/bin/*)
	    bug_file=$(mktemp)
	    rm -f "$bug_file"
	    "$provider" --getrawdata "$json" 2>"$bug_file" | "${player_bin[0]}" >/dev/null 2>&1 &
	    PLAY_PID=$(echo $!) #just get player, cut output, input over
	    sleep 0.2
	    # echo "lllllll" >&2
	    # cat "$bug_file" >&2
	    # echo "lllllll" >&2
            # 检查 PID 是否有效
	    if [[ "$PLAY_PID" =~ ^[0-9]+$ ]] && [ "$PLAY_PID" -gt 0 ] && [ ! -s "$bug_file" ]; then
		rm -f "$bug_file"
                # 成功！
                echo -e "${GREEN}✅ 播放器启动成功: $(basename "$provider")${NC}\n" >&2
                
                # 获取封面和标题
                COVER_PATH=$("$provider" --cover "$json" 2>/dev/null)
                TITLE=$("$provider" --title "$json" 2>/dev/null)

                echo "$provider|$PLAY_PID|$COVER_PATH|$TITLE" >&2
                echo "$provider|$PLAY_PID|$COVER_PATH|$TITLE"
                return 0
            else
		rm -f "$bug_file"
                echo -e "${RED}❌ 播放器失败: $(basename "$provider")${NC}\n" >&2
            fi
        fi
    done
    
    echo -e "${RED}❌ 没有找到可用的播放器${NC}\n" >&2
    return 1
}

# ============================================
# 显示播放列表
# ============================================
show_playlist() {
    local file="$1"
    if [[ ! -f "$file" ]] || [[ ! -s "$file" ]]; then
        echo -e "${YELLOW}📋 播放列表为空${NC}"
        return
    fi
    
    local count=$(wc -l < "$file" 2>/dev/null || echo 0)
    echo -e "\n${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}📋 播放列表 (共 $count 首)${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    
    local line_num=0
    while IFS= read -r line; do
        line_num=$((line_num + 1))
        # 解析 JSON 行
        title=$(echo "$line" | jq -r '.title // "未知"')
        cid=$(echo "$line" | jq -r '.cid // ""')
        
        if [[ $line_num -eq 1 ]]; then
            echo -e "${YELLOW}▶ ${line_num}.${NC} $title ${BLUE}[$cid]${NC} ${GREEN}← 当前${NC}"
        else
            echo -e "  ${line_num}. $title ${BLUE}[$cid]${NC}"
        fi
    done < "$file"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
}

# ============================================
# 读取并删除第一行
# ============================================
pop_first_line() {
    local file="$1"
    local first_line=""
    
    if [[ ! -f "$file" ]] || [[ ! -s "$file" ]]; then
        echo ""
        return 1
    fi
    
    first_line=$(head -n 1 "$file")
    tail -n +2 "$file" > "$file.tmp"
    mv "$file.tmp" "$file"
    
    echo "$first_line"
    return 0
}

# ============================================
# 把行写回文件顶部
# ============================================
push_back_first_line() {
    local file="$1"
    local line="$2"
    
    if [[ -z "$line" ]]; then
        return
    fi
    
    echo "$line" | cat - "$file" > "$file.tmp"
    mv "$file.tmp" "$file"
}

# ============================================
# 监控播放器进程（独立子进程）
# ============================================
monitor_player() {
    local pid="$1"
    tail --pid="$pid" -f /dev/null 2>/dev/null
    send_ui_started 
}

# ============================================
# 主循环
# ============================================
main() {
    echo -e "\033[?25l"
    # 检查播放列表
    if [[ ! -f "$PLAYLIST_FILE" ]]; then
        echo -e "${YELLOW}⏳ 等待播放列表创建...${NC}"
        sleep 2
    fi
    
    echo -e "${GREEN}🎵 播放器调度器已启动${NC}"
    echo -e "${BLUE}📂 播放器目录: $DATA_SOURCE_DIR${NC}"
    echo ""
    
    # 播放次数默认 1
    REPEAT_COUNT=0
    SONG_LOOP=1

    # set -m
    # listen_control &
    # LISTENER_PID=$!
    # set +m
    
    while true; do
        # 检查播放列表是否存在且有内容
        if [[ ! -f "$PLAYLIST_FILE" ]] || [[ ! -s "$PLAYLIST_FILE" ]]; then
            echo -e -n "\r${YELLOW}⏳ 等待播放列表添加歌曲...${NC}"
            sleep 5
            continue
        fi
        
        # 读取第一行
        # FIRST_LINE=$(pop_first_line "$PLAYLIST_FILE")
        # FIRST_LINE=$(./gateway/gateway.sh pop)
        FIRST_LINE=$($SCRIPT_DIR/../gateway/gateway.sh getnext)
        if [[ -z "$FIRST_LINE" ]]; then
            continue
        fi
        
	echo "read:$FIRST_LINE" >&2
        # 解析 JSON
        SCHEME=$(echo "$FIRST_LINE" | jq -r '.scheme // ""')
        
        
        echo -e "${BLUE}   Scheme: $SCHEME${NC}"
        echo ""
        
        # ============================================
        # ★★★ 使用插件 API 播放 ★★★
        # ============================================
        result=$(find_and_play "$FIRST_LINE")
	echo "found!" >&2
        if [ $? -ne 0 ] || [ -z "$result" ]; then
            echo -e "${RED}❌ 播放失败，跳过此曲${NC}"
	    $SCRIPT_DIR/../gateway/gateway.sh finish "$FIRST_LINE"
            continue
        fi
        
        # 解析结果
        IFS='|' read -r FOUND_PLAYER PLAY_PID COVER_PATH TITLE <<< "$result"
        
        echo -e "${GREEN}✅ 播放器: $(basename "$FOUND_PLAYER")${NC}"
        echo -e "${GREEN}✅ PID: $PLAY_PID${NC}"
        echo -e "${GREEN}✅ 封面: $COVER_PATH${NC}"
        
	# listen_ui_started &
        # ============================================
        # 键盘监听
        # ============================================
        echo -e "\n${BLUE}按 1-9 改变播放次数 | p 暂停 | x 跳过 | q 退出${NC}"
        
        PAUSED=false

        
	# ★★★ 启动监控子进程 ★★★
	monitor_player "$PLAY_PID" &
	MONITOR_PID=$!

	send_ui_started 

	publish_dbus "$PLAY_PID" "$TITLE" "$COVER_PATH" "$REPEAT_COUNT" "$PAUSED"


	
	# ============================================
	# 主循环 - 从管道读取
	# ============================================
	while read -r line; do
	    # 检查播放器是否还在
	    if ! kill -0 "$PLAY_PID" 2>/dev/null; then
	        echo "📡 播放器已退出，停止监听" >&2
	        break
	    fi
	    
	    ACTION=$(echo "$line" | cut -d'|' -f1)
	    DATA=$(echo "$line" | cut -d'|' -f2-)
	    
	    case "$ACTION" in
	        'number')
	            REPEAT_COUNT="$DATA"
	            SONG_LOOP=$((REPEAT_COUNT + 1))
	            echo -e "\n${GREEN}🔄 播放次数: $SONG_LOOP${NC}"
	            publish_dbus "$PLAY_PID" "$TITLE" "$COVER_PATH" "$REPEAT_COUNT" "$PAUSED"
	            ;;
	            
	        'pause')
	            if [ "$DATA" = "true" ]; then
	                kill -STOP "$PLAY_PID" 2>/dev/null
	                PAUSED=true
	                echo -e "\r⏸ 已暂停"
	            else
	                kill -CONT "$PLAY_PID" 2>/dev/null
	                PAUSED=false
	                echo -e "\r▶ 继续播放"
	            fi
	            publish_dbus "$PLAY_PID" "$TITLE" "$COVER_PATH" "$REPEAT_COUNT" "$PAUSED"
	            ;;
	            
	        'skip')
	            echo -e "\n⏹ 跳过此曲"
	            kill "$PLAY_PID" 2>/dev/null
		    $SCRIPT_DIR/../gateway/gateway.sh finish "$FIRST_LINE"
	            REPEAT_COUNT=$((SONG_LOOP - 1))
		    ACTION=""
		    DATA=""
	            # ★★★ 跳出循环（跳到下一首） ★★★
		    continue 2
	            ;;
	            
	        'quit')
	            # push_back_first_line "$PLAYLIST_FILE" "$FIRST_LINE"
		    # ./gateway/gateway.sh push "$FIRST_LINE"
	            kill "$PLAY_PID" 2>/dev/null
	            echo -e "\n👋 退出播放"
	            # ★★★ 清理管道 ★★★
	            rm -f "$CONTROL_PIPE"
	            exit 0
	            ;;
	            
	        'ui_started')
	            UI_PID="$DATA"
	            echo "🖥️ UI 已启动 (PID: $UI_PID)"
	            if [ -n "$PLAY_PID" ] && [ "$PLAY_PID" -gt 0 ]; then
	                publish_dbus "$PLAY_PID" "$TITLE" "$COVER_PATH" "$REPEAT_COUNT" "$PAUSED"
	            fi
	            ;;
	            
	        *)
	            echo "⚠️ 未知控制信号: $ACTION" >&2
	            ;;
	    esac
	done < <($SCRIPT_DIR/lib/listen_control.py 2>/dev/null)
        
        # 播放完成
        wait "$PLAY_PID" 2>/dev/null || true
	# ★★★ 清理监控进程 ★★★
	kill "$MONITOR_PID" 2>/dev/null
        
        # 处理重复播放
        if [[ $REPEAT_COUNT -gt 0 ]]; then
            ((REPEAT_COUNT--))
            # push_back_first_line "$PLAYLIST_FILE" "$FIRST_LINE"
            # ./gateway/gateway.sh push "$FIRST_LINE"
        else
            REPEAT_COUNT=$((SONG_LOOP - 1))
            $SCRIPT_DIR/../gateway/gateway.sh finish "$FIRST_LINE"
        fi
        
        echo -e "\n${GREEN}✓ 完成: $TITLE${NC}"
        echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
        
        sleep 0.5
    done
}

