    # kill -- -"$LISTENER_PID" 2>/dev/null
    # pkill -f listen_control.py 2>/dev/null
    echo -e "\033[?25h"
    reset
    echo -e "\n${GREEN}👋 清理完成${NC}"
}

trap cleanup EXIT

# ============================================
# 启动
# ============================================
main
