#!/usr/bin/env bash
#
# healthcheck - Health check for the gateway (CLI + daemon + HTTP)
#
# Usage:
#   ./healthcheck                 # full check (starts a temp daemon if needed)
#   ./healthcheck --no-daemon     # skip daemon/HTTP checks
#   ./healthcheck --no-network    # skip remote probes
#
# Exit codes:
#   0 = all checks passed
#   1 = one or more checks failed
#

set -u

# ---------- locate ourselves ----------
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    dir="$(cd -P "$(dirname -- "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    case "$SELF" in
        /*) ;;
        *) SELF="$dir/$SELF" ;;
    esac
done
SELF_DIR="$(cd -P "$(dirname -- "$SELF")" && pwd)"

GATEWAY_SH="$SELF_DIR/gateway.sh"
GATEWAY_PY="$SELF_DIR/gateway_daemon.py"
SOURCE_LIST="$SELF_DIR/source_list.txt"
DAEMON_PID_FILE="/tmp/gateway_daemon.pid"
HISTORY_FILE="/tmp/gateway_history.jsonl"
CHECKOUT_DIR="${CHECKOUT_DIR:-/tmp/gateway_checkout}"

# ---------- flags ----------
WANT_DAEMON=1
WANT_NETWORK=1
for arg in "$@"; do
    case "$arg" in
        --no-daemon)  WANT_DAEMON=0 ;;
        --no-network) WANT_NETWORK=0 ;;
        -h|--help)
            sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *) echo "unknown flag: $arg" >&2; exit 2 ;;
    esac
done

# ---------- colors ----------
if [ -t 1 ]; then
    RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; NC=$'\033[0m'
else
    RED=""; GREEN=""; YELLOW=""; NC=""
fi

PASS=0; FAIL=0

ok()   { printf '%s[ OK ]%s %s\n'   "$GREEN"  "$NC" "$1"; PASS=$((PASS+1)); }
bad()  { printf '%s[FAIL]%s %s\n'   "$RED"    "$NC" "$1"; FAIL=$((FAIL+1)); }
warn() { printf '%s[WARN]%s %s\n'   "$YELLOW" "$NC" "$1"; }
info() { printf '[INFO] %s\n' "$1"; }

info "gateway dir: $SELF_DIR"

# ---------- 1. files ----------
[ -f "$GATEWAY_SH" ] && ok "gateway.sh present" || { bad "gateway.sh missing: $GATEWAY_SH"; exit 1; }
[ -x "$GATEWAY_SH" ] && ok "gateway.sh executable" || warn "gateway.sh not executable"

if [ "$WANT_DAEMON" -eq 1 ]; then
    [ -f "$GATEWAY_PY" ] && ok "gateway_daemon.py present" || bad "gateway_daemon.py missing: $GATEWAY_PY"
fi

# ---------- 2. external tools ----------
for tool in bash jq curl python3; do
    if command -v "$tool" >/dev/null 2>&1; then
        ok "$tool available"
    else
        bad "$tool not found in PATH"
    fi
done

command -v realpath >/dev/null 2>&1 && ok "realpath available" || warn "realpath missing (some paths won't be canonicalized)"

# ---------- 3. source_list.txt ----------
if [ ! -f "$SOURCE_LIST" ]; then
    bad "source_list.txt missing: $SOURCE_LIST"
    CURRENT_URI=""
else
    CURRENT_URI="$(head -n 1 "$SOURCE_LIST" 2>/dev/null || true)"
    if [ -z "$CURRENT_URI" ]; then
        bad "source_list.txt is empty"
    else
        ok "source_list.txt first line: $CURRENT_URI"
        case "$CURRENT_URI" in
            file://*)
                p="${CURRENT_URI#file://}"
                case "$p" in
                    /*) ;;
                    *) p="$SELF_DIR/$p" ;;
                esac
                if [ -f "$p" ]; then
                    ok "local source resolves: $p"
                else
                    bad "local source does not exist: $p"
                fi
                ;;
            http://*|https://*)
                if [ "$WANT_NETWORK" -eq 1 ]; then
                    if curl -fsS --max-time 5 "${CURRENT_URI%/}/count" >/dev/null 2>&1; then
                        ok "remote source reachable: $CURRENT_URI"
                    else
                        warn "remote source unreachable (may be offline): $CURRENT_URI"
                    fi
                fi
                ;;
            *)
                warn "source URI has unknown scheme: $CURRENT_URI"
                ;;
        esac
    fi
fi

# ---------- 4. gateway.sh CLI smoke tests ----------
if "$GATEWAY_SH" help >/dev/null 2>&1; then
    ok "gateway help exits 0"
else
    bad "gateway help failed"
fi

if out=$("$GATEWAY_SH" source 2>/dev/null); then
    [ -n "$out" ] && ok "gateway source → $out" || warn "gateway source returned empty"
else
    warn "gateway source failed (may be empty source_list)"
fi

if out=$("$GATEWAY_SH" count 2>/dev/null); then
    case "$out" in
        ''|*[!0-9]*) warn "gateway count returned non-numeric: '$out'" ;;
        *)           ok "gateway count → $out" ;;
    esac
else
    warn "gateway count failed"
fi

# ---------- 5. daemon / HTTP ----------
if [ "$WANT_DAEMON" -eq 1 ]; then
    DAEMON_STARTED_BY_US=0
    DAEMON_PID=""
    TEST_PORT=""

    # Reuse an existing daemon if one is running
    if [ -f "$DAEMON_PID_FILE" ]; then
        DAEMON_PID="$(cat "$DAEMON_PID_FILE" 2>/dev/null || true)"
        if [ -n "$DAEMON_PID" ] && kill -0 "$DAEMON_PID" 2>/dev/null; then
            ok "existing daemon running (PID $DAEMON_PID)"
            if command -v ss >/dev/null 2>&1; then
                TEST_PORT="$(ss -ltnp 2>/dev/null | awk -v pid="$DAEMON_PID" '$0 ~ pid {print $4}' | awk -F: '{print $NF}' | head -n1)"
            fi
        else
            warn "stale daemon PID file (PID $DAEMON_PID not running)"
        fi
    fi

    # Otherwise spin up a temporary daemon
    if [ -z "$TEST_PORT" ] && [ -f "$GATEWAY_PY" ]; then
        TEST_PORT="${GATEWAY_TEST_PORT:-18921}"
        info "starting temporary daemon on port $TEST_PORT"
        python3 "$GATEWAY_PY" "$TEST_PORT" >/tmp/gateway_hc_daemon.log 2>&1 &
        DAEMON_STARTED_BY_US=1
        DAEMON_PID=$!

        for _ in $(seq 1 15); do
            if curl -fsS --max-time 1 "http://127.0.0.1:$TEST_PORT/count" >/dev/null 2>&1; then
                break
            fi
            sleep 0.2
        done
    fi

    if [ -n "$TEST_PORT" ]; then
        BASE="http://127.0.0.1:$TEST_PORT"

        # GET /count
        if out=$(curl -fsS --max-time 3 "$BASE/count" 2>/dev/null); then
            ok "GET /count → $out"
        else
            bad "GET /count failed"
        fi

        # GET /dashboard
        if out=$(curl -fsS --max-time 3 "$BASE/dashboard" 2>/dev/null); then
            echo "$out" | grep -qi '<!DOCTYPE html>' \
                && ok "GET /dashboard returns HTML" \
                || warn "GET /dashboard returned non-HTML"
        else
            bad "GET /dashboard failed"
        fi

        # GET /stats
        if out=$(curl -fsS --max-time 3 "$BASE/stats" 2>/dev/null); then
            if echo "$out" | jq -e 'has("total") and has("success") and has("error") and has("avg_ms")' >/dev/null 2>&1; then
                ok "GET /stats JSON shape OK"
            else
                warn "GET /stats missing expected keys: $out"
            fi
        else
            bad "GET /stats failed"
        fi

        # GET /history
        if out=$(curl -fsS --max-time 3 "$BASE/history" 2>/dev/null); then
            echo "$out" | jq -e 'type == "array"' >/dev/null 2>&1 \
                && ok "GET /history returns array" \
                || warn "GET /history not an array"
        else
            bad "GET /history failed"
        fi

        # POST /count — read-only, exercises the POST code path without writing
        if out=$(curl -fsS --max-time 3 -X POST "$BASE/count" \
                    -H "Content-Type: application/json" -d '[]' 2>/dev/null); then
            ok "POST /count → $out"
        else
            bad "POST /count failed"
        fi

        # POST /first — also read-only
        if out=$(curl -fsS --max-time 3 -X POST "$BASE/first" \
                    -H "Content-Type: application/json" -d '[]' 2>/dev/null); then
            ok "POST /first → ${out:0:60}"
        else
            bad "POST /first failed"
        fi
    else
        warn "no daemon port detected; skipping HTTP tests"
    fi

    # cleanup if we started it
    if [ "$DAEMON_STARTED_BY_US" -eq 1 ] && [ -n "$DAEMON_PID" ]; then
        kill "$DAEMON_PID" 2>/dev/null
        wait "$DAEMON_PID" 2>/dev/null
        info "temporary daemon stopped"
    fi
fi

# ---------- 6. state dirs ----------
if [ -d "$CHECKOUT_DIR" ]; then
    if [ -w "$CHECKOUT_DIR" ]; then
        ok "checkout dir writable: $CHECKOUT_DIR"
    else
        bad "checkout dir not writable: $CHECKOUT_DIR"
    fi
else
    parent="$(dirname -- "$CHECKOUT_DIR")"
    [ -w "$parent" ] \
        && ok "checkout dir will be created under $parent" \
        || warn "checkout dir missing and $parent not writable"
fi

if [ -f "$HISTORY_FILE" ]; then
    ok "history file present: $HISTORY_FILE"
else
    info "history file not yet created: $HISTORY_FILE"
fi

# ---------- summary ----------
echo
printf 'Summary: %s%d passed%s, %s%d failed%s\n' \
    "$GREEN" "$PASS" "$NC" \
    "$RED"   "$FAIL" "$NC"

[ "$FAIL" -eq 0 ]
